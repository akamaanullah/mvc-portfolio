# Root rewrite: everything is served from /public (use when the vhost/XAMPP folder points at the project root)
Options -Indexes
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  # block private folders and dotfiles
  RewriteRule ^(app|bin|config|database|storage|views|vendor)(/|$) - [F,L]
  RewriteRule (^|/)\.(?!well-known) - [F,L]
  RewriteRule ^(composer\.(json|lock)|README\.md)$ - [F,L]
  # static file in public/?
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} !-f
  RewriteCond %{REQUEST_URI} !^.*/public/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

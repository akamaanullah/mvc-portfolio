APP_NAME="Amaanullah"
APP_ENV=local
APP_DEBUG=true
APP_URL=
APP_TIMEZONE=Asia/Karachi

# Database
DB_ENABLED=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=web3d
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Cloudflare AI (Chatbot)
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token
CF_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fast

# SMTP Mail Server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_ENCRYPTION=ssl
SMTP_FROM=your_email@gmail.com
SMTP_FROM_NAME="Amaanullah Khan Portfolio"

# Google PageSpeed & Search Console
PAGESPEED_API_KEY=your_pagespeed_api_key
GSC_KEY_PATH="config/keys/search-console-key.json"
GSC_SITE_URL="https://amaanullah.com/"

# Business & Support Contact
CONTACT_PHONE="+92 319 6935307"
CONTACT_WHATSAPP="https://api.whatsapp.com/send?phone=923196935307"
CONTACT_EMAIL=info@amaanullah.com

LOG_LEVEL=debug
